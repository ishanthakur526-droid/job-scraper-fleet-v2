{
  "type": "object",
  "additionalProperties": false,
  "required": ["companies"],
  "properties": {
    "companies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["company_name", "reason", "career_urls", "ats_hint", "role_families"],
        "properties": {
          "company_name": {"type": "string", "minLength": 2},
          "reason": {"type": "string", "maxLength": 300},
          "career_urls": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {"type": "string", "pattern": "^https?://"}
          },
          "ats_hint": {
            "type": "string",
            "enum": ["workday", "oracle_hcm", "smartrecruiters", "greenhouse", "lever", "ashby", "successfactors", "other"]
          },
          "role_families": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "enum": ["data_bi", "research", "excel_mis"]}
          }
        }
      }
    }
  }
}
